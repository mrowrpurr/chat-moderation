{
  "name": "chat-moderation",
  "version": "0.1.0",
  "description": "Local toxicity and emotion scoring with Detoxify unbiased and GoEmotions (ONNX) for Bun and Node 🍞",
  "type": "module",
  "license": "MIT OR 0BSD",
  "author": "Mrowr Purr <mrowr.purr@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrowrpurr/chat-moderation.git"
  },
  "homepage": "https://github.com/mrowrpurr/chat-moderation#readme",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/*.test.ts",
    "!src/test-models.ts",
    "!src/testing.ts",
    "README.md",
    "LICENSE",
    "LICENSE-0BSD"
  ],
  "scripts": {
    "test": "bun test",
    "test:node": "node --test --test-concurrency=1 src/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run typecheck && bun run build"
  },
  "keywords": [
    "bun",
    "node",
    "moderation",
    "toxicity",
    "emotion",
    "detoxify",
    "goemotions",
    "onnx",
    "transformers",
    "chat",
    "nlp"
  ],
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=22"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.2",
    "7zip-bin": "^5.2.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
